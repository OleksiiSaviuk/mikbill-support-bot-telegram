APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Kiev

TZ="${APP_TIMEZONE}"

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
DB_ROOT_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

TELEGRAM_TIMEZONE="${APP_TIMEZONE}"
TELEGRAM_BOT_TOKEN="your:telegram-token"
TELEGRAM_BOT_NAME="YourBotName"
TELEGRAM_BOT_ALLOWED_ID="[1111111, 222222]"
TELEGRAM_SEARCH_PER_PAGE=5
TELEGRAM_ENABLE_START_PHONE_SEARCH=false
TELEGRAM_HISTORY_RETENTION_DAYS=7
TELEGRAM_HISTORY_TRACK_LIMIT=5000
TELEGRAM_HISTORY_PURGE_INTERVAL_SECONDS=300
TELEGRAM_HISTORY_DELETE_BATCH_SIZE=25
TELEGRAM_DEFAULT_PHONE_COUNTRY_CODE=38
MIKBILL_TICKETS_ENABLED=true
MIKBILL_TICKETS_LIMIT=10
MIKBILL_TICKETS_OPERATORS="[1:111111]"
MIKBILL_TICKETS_MAX_MESSAGE_LENGTH=500
MIKBILL_TICKETS_DB_HOST=
MIKBILL_TICKETS_DB_PORT=3306
MIKBILL_TICKETS_DB_NAME=
MIKBILL_TICKETS_DB_USER=
MIKBILL_TICKETS_DB_PASSWORD=

MIKBILL_CABINET_HOST="https://stat.my-domen.ru"
MIKBILL_HOST="https://admin.my-domen.ru"
MIKBILL_LOGIN=admin
MIKBILL_PASSWORD=admin
WILDCORE_ENABLED=false
WILDCORE_URL=
WILDCORE_API_KEY=
